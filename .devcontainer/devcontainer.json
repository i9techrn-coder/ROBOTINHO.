{
  "name": "ROBOTINHO Online",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/pwa:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-ceintl.vscode-language-pack-pt-BR"
      ]
    }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y google-chrome-stable",
  "postCreateCommand": "pip3 install --user -r requirements.txt",
  "remoteUser": "vscode"
}